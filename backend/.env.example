# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ─────────────────────────────────────────────────
# Local example:  mongodb://localhost:27017/electronics-store
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>/electronics-store
MONGODB_URI=mongodb://localhost:27017/electronics-store

# ─── JWT secrets (use strong random strings, min 32 chars) ───
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ─── Admin seed credentials (used by `npm run seed`) ─────────
ADMIN_EMAIL=admin@electronics.com
ADMIN_PASSWORD=Admin123!@#

# ─── CORS / frontend URLs ────────────────────────────────────
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Firebase Admin (verifies Google OAuth ID tokens) ────────
# Preferred: paste the entire service account JSON as ONE line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
#
# Fallback: individual fields (private_key uses literal \n for newlines):
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_CLIENT_ID=
FIREBASE_CERT_URL=

# ─── Cloudinary (product image uploads) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Nova Poshta API (delivery integration) ──────────────────
NOVA_POSHTA_API_KEY=your-nova-poshta-api-key
